<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CakeTime.Presentation.ViewModels"
             xmlns:models="clr-namespace:CakeTime.Domain;assembly=CakeTime.Domain"
             x:DataType="viewmodels:EventsListViewModel"
             x:Class="CakeTime.Presentation.Views.EventListContent">
    <ScrollView
            Grid.Row="1">
        <VerticalStackLayout>
            <Label Text="События:"/>

            <CollectionView x:Name="EventsItems" ItemsSource="{Binding Events}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventData">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}"/>
                            <Button
                                Text="Удалить"
                                Command="{Binding x:DataType='viewmodels:EventsListViewModel', Source={RelativeSource AncestorType={x:Type viewmodels:EventsListViewModel}}, Path=DeleteEventCommand}"
                                CommandParameter="{Binding Id}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
