<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CakeTime.Presentation.ViewModels"
             x:DataType="viewmodels:EventsListViewModel"
             x:Class="CakeTime.Presentation.Views.EventListContent">
    <ScrollView
            Grid.Row="1">
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
        <Image
            Source="cake.svg"
            HeightRequest="185"
            Aspect="AspectFit"
            SemanticProperties.Description="cake" />

        <Label
            Text="Hello, World! 2"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
