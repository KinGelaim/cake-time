<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CakeTime.Presentation.ViewModels"
             xmlns:models="clr-namespace:CakeTime.Presentation.Models"
             x:DataType="viewmodels:EventsListViewModel"
             x:Class="CakeTime.Presentation.Views.EventListContent">
    <ScrollView>
        <VerticalStackLayout>
            <CollectionView ItemsSource="{Binding EventsGroups}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventDataGroup">
                        <VerticalStackLayout>
                            <Border
                                    Margin="10"
                                    Padding="0,5"
                                    WidthRequest="100"
                                    HorizontalOptions="Start"
                                    BackgroundColor="#CC98FE58"
                                    Stroke="#3EB489">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding Title}" HorizontalTextAlignment="Center"/>
                            </Border>

                            <CollectionView ItemsSource="{Binding Events}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EventDataView">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding x:DataType='viewmodels:EventsListViewModel', Source={RelativeSource AncestorType={x:Type viewmodels:EventsListViewModel}}, Path=EditEventCommand}"
                                                    CommandParameter="{Binding Id}"/>
                                            </Grid.GestureRecognizers>

                                            <Border
                                                    Grid.RowSpan="3"
                                                    StrokeThickness="5"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#70D577"
                                                    WidthRequest="60"
                                                    HeightRequest="80"
                                                    HorizontalOptions="End">
                                                <Image
                                                    Source="human1.png"
                                                    WidthRequest="60" />
                                            </Border>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                                                Margin="0,0,8,0"
                                                HorizontalOptions="End"/>

                                            <Border
                                                    Grid.Column="1"
                                                    Grid.Row="1"
                                                    Background="#CC3DD9A0"
                                                    Margin="0,0,8,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5"/>
                                                </Border.StrokeShape>
                                                <Label
                                                    Margin="8"
                                                    Text="{Binding Name}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>